name: CI/CD Multi-Environment Pipeline

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  # 1. CONTINUOUS INTEGRATION (CI): Test & Lint
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-node: '20'
          cache: 'npm' # Speeds up performance by caching dependencies

      - name: Install Dependencies
        run: npm ci

      - name: Run Linter & Tests
        run: |
          npm run lint
          npm test

  # 2. DEPLOY TO STAGING (Triggered by changes to the 'develop' branch)
  deploy-staging:
    needs: test
    if: github.ref == 'refs/heads/develop' && github.event_name == 'push'
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Deploy to Staging Server
        run: npm run deploy:staging
        env:
          API_KEY: ${{ secrets.STAGING_API_KEY }}

  # 3. DEPLOY TO PRODUCTION (Triggered only by changes to the 'main' branch)
  deploy-production:
    needs: test
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    environment: production # Connects to GitHub Environments for manual gates
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Deploy to Production Server
        run: npm run deploy:prod
        env:
          API_KEY: ${{ secrets.PROD_API_KEY }}
